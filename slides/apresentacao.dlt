          <column>Módulo</column>
          <column>ENEM (regressão)</column>
          <column>CTG (classificação)</column>
        </header>
        <row><column><c>linear_model</c></column><column>Linear, Ridge, Lasso</column><column>Regressão logística</column></row>
        <row><column><c>neighbors</c></column><column>KNN</column><column>KNN</column></row>
        <row><column><c>discriminant_analysis</c></column><column>—</column><column>LDA, QDA</column></row>
