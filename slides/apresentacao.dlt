  <slide><toc/></slide>

  <section >
    <title>Biblioteca contruída: StatsTech</title>
    <slide>
      <table id="tbl:modulos" max-height="600px">
      <title>Módulos implementados</title>
      <header>
        <column>Módulo</column>
        <column align="right">Métodos</column>
      </header>
      <row><column><c>linear_model</c></column><column align="right">Mínimos quadrados, Ridge, Lasso, regressão logística</column></row>
      <row><column><c>neighbors</c></column><column align="right">KNN</column></row>
      <row><column><c>discriminat_analysis</c></column><column align="right">LDA, QDA</column></row>
      <row><column><c>tree</c></column><column align="right">Árvores de decisão (regressão e classificação)</column></row>
      <row><column><c>neural_network</c></column><column align="right">Redes neurais (regressão)</column></row>
      <row><column><c>decomposition</c></column><column align="right">PCA</column></row>
      <row><column><c>cluster</c></column><column align="right">K-means</column></row>
      <row><column><c>model_selection</c></column><column align="right">Divisão treino/teste, k-fold, LOOCV, bootstrap, busca de hiperparâmetros</column></row>
      <row><column><c>metrics</c></column><column align="right">Métricas de regressão e de classificação</column></row>
      <row><column><c>preprocessing</c></column><column align="right">	Padronização, codificação de categorias, imputação de valores faltantes, features polinomiais (para regressão polinomial)</column></row>
      <row><column><c>pipeline</c></column><column align="right">Encadeamento de pré-processamento e modelo, reajustado em cada fold da validação cruzada</column></row>
    </table>


    </slide>
    
  </section>

